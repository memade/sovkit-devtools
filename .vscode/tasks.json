{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DevTools: configure Windows Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "windows-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "DevTools: build Windows Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "windows-debug",
        "--parallel",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "DevTools: configure Windows Debug"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [
        "$msCompile"
      ],
      "group": "build"
    },
    {
      "label": "DevTools: test Windows Debug",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "windows-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "DevTools: build Windows Debug"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "DevTools: configure Linux x64 Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "linux-x64-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "DevTools: build Linux x64 Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "linux-x64-debug",
        "--parallel",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "dependsOn": [
        "DevTools: configure Linux x64 Debug"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "DevTools: test Linux x64 Debug",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "linux-x64-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "DevTools: build Linux x64 Debug"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "DevTools: configure Linux arm64 Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "linux-arm64-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "DevTools: build Linux arm64 Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "linux-arm64-debug",
        "--parallel",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "dependsOn": [
        "DevTools: configure Linux arm64 Debug"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "DevTools: test Linux arm64 Debug",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "linux-arm64-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": [
        "DevTools: build Linux arm64 Debug"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "DevTools: configure macOS Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "macos-arm64-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "DevTools: build macOS Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "macos-arm64-debug",
        "--parallel",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build",
      "dependsOn": [
        "DevTools: configure macOS Debug"
      ],
      "dependsOrder": "sequence"
    }
  ]
}
