{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DevTools · Windows x64 Debug",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/out/Debug/sovkit-devtools.exe",
      "args": [],
      "cwd": "${workspaceFolder}/out/Debug",
      "console": "internalConsole",
      "stopAtEntry": false,
      "symbolSearchPath": "${workspaceFolder}/out/Debug",
      "requireExactSource": true,
      "preLaunchTask": "DevTools: build Windows Debug"
    },
    {
      "name": "DevTools · Linux x64 Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/linux-x64-debug/sovkit-devtools",
      "args": [],
      "cwd": "${workspaceFolder}/.build/linux-x64-debug",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "DevTools: build Linux x64 Debug"
    },
    {
      "name": "DevTools · Linux arm64 Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/linux-arm64-debug/sovkit-devtools",
      "args": [],
      "cwd": "${workspaceFolder}/.build/linux-arm64-debug",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "DevTools: build Linux arm64 Debug"
    },
    {
      "name": "DevTools · macOS Debug",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/.build/macos-arm64-debug/sovkit-devtools.app/Contents/MacOS/sovkit-devtools",
      "args": [],
      "cwd": "${workspaceFolder}",
      "terminal": "console",
      "stopOnEntry": false,
      "preLaunchTask": "DevTools: build macOS Debug"
    }
  ]
}
