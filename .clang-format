---
Language: Cpp
BasedOnStyle: Microsoft

# One TAB per indentation level; spaces for continuation/alignment.
IndentWidth: 4
TabWidth: 4
UseTab: ForIndentation
ContinuationIndentWidth: 4

# Keep function/class/struct/namespace opening braces on the declaration line.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: false
  AfterClass: false
  AfterStruct: false
  AfterControlStatement: Always
  AfterNamespace: false
  AfterEnum: true
  AfterUnion: true
  AfterExternBlock: true
  BeforeCatch: true
  BeforeElse: true
NamespaceIndentation: All
AccessModifierOffset: -4
IndentAccessModifiers: false
IndentCaseLabels: false
IndentPPDirectives: None
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortEnumsOnASingleLine: false

# Match declarations such as Type* value and const Type& value.
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Pointer
SpaceBeforeParens: ControlStatements

# Like VS document formatting, do not force a fixed line length.
ColumnLimit: 0

# Keep source ordering and comments when formatting documents.
SortIncludes: false
IncludeBlocks: Preserve
SortUsingDeclarations: false
ReflowComments: false
FixNamespaceComments: false

---
Language: Proto
BasedOnStyle: Google
ColumnLimit: 80
IndentWidth: 2
UseTab: Never

